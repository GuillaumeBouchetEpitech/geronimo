    {
      "name": "full-building",
      "operations": [

        // building
        {
          "type": "add-instance",
          "target": "triple-stairs---now-connected",
          "origin": [0.0, 0.0,  0.0]
        },
        {
          "type": "add-instance",
          "target": "triple-stairs---now-connected",
          "transforms": [
            { "type": "translate", "pos": [180,60,0] },
            { "type": "rotate", "axis": [0,0,1], "angle": 180 }
